**/ios/Flutter/.last_build_id
app.*.symbols
app.*.map.json
.widget_preview/
*.dill
*.snapshot

# ---- IDE / 编辑器 ---------------------------------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
